# Get this from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get this from console.cloud.google.com — enable "YouTube Data API v3" in
# the same or a new project, then Credentials -> Create Credentials -> API Key.
# Restrict it to YouTube Data API v3 only.
YOUTUBE_API_KEY=your_youtube_api_key_here

# How often the app runs research automatically, as a cron expression.
# Default below = every day at 08:00 server time.
RESEARCH_CRON=0 8 * * *

# Port the dashboard runs on
PORT=3000

# Simple shared password to protect the dashboard and the manual "run now"
# button. Leave blank to disable (not recommended if hosting publicly).
DASHBOARD_PASSWORD=change_me
